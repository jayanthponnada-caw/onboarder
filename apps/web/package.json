{
	"name": "web",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vp build && node -e \"require('node:fs').copyFileSync('instrument.server.mjs', '.output/server/instrument.server.mjs')\"",
		"check-types": "tsc --noEmit",
		"dev": "vp dev --port 3000",
		"format": "vp fmt . --write",
		"format:check": "vp fmt . --check",
		"lint": "vp lint . --type-aware --import-plugin",
		"preview": "vp preview",
		"start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
		"test": "vp test run"
	},
	"dependencies": {
		"@clerk/tanstack-react-start": "^1.3.2",
		"@clerk/ui": "^1.14.0",
		"@orpc/client": "^1.14.3",
		"@orpc/openapi-client": "1.14.3",
		"@orpc/tanstack-query": "^1.14.3",
		"@repo/api-contract": "workspace:^",
		"@repo/design-system": "workspace:*",
		"@sentry/tanstackstart-react": "^10.42.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/db": "0.6.6",
		"@tanstack/query-core": "5.100.11",
		"@tanstack/query-db-collection": "1.0.37",
		"@tanstack/react-db": "0.1.84",
		"@tanstack/react-query": "^5.100.11",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "^1.132.0",
		"lucide-react": "^0.545.0",
		"nitro": "npm:nitro-nightly@latest",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@repo/oxc-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query-devtools": "5.100.11",
		"@tanstack/react-router-devtools": "latest",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"typescript": "^6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
